{
  "title": "OpsDesk — Service overview",
  "description": "API health, AI assist performance, billing webhooks and business metrics for opsdesk-web. Metrics are emitted via DogStatsD from src/server/observability/metrics.ts; logs are correlated to traces through dd.trace_id / dd.span_id.",
  "layout_type": "ordered",
  "reflow_type": "auto",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "available_values": [],
      "default": "production"
    }
  ],
  "widgets": [
    {
      "definition": {
        "title": "API health",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "API error rate (5xx, %)",
              "type": "query_value",
              "precision": 2,
              "custom_unit": "%",
              "autoscale": true,
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "errors",
                      "query": "sum:opsdesk.api.requests{$env,status_class:5xx}.as_count()",
                      "aggregator": "sum"
                    },
                    {
                      "data_source": "metrics",
                      "name": "total",
                      "query": "sum:opsdesk.api.requests{$env}.as_count()",
                      "aggregator": "sum"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "100 * errors / total"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 5,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">",
                      "value": 2,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<=",
                      "value": 2,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "title": "API p95 latency",
              "type": "query_value",
              "precision": 0,
              "custom_unit": "ms",
              "autoscale": true,
              "requests": [
                {
                  "response_format": "scalar",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "p95",
                      "query": "avg:opsdesk.api.latency_ms.95percentile{$env}",
                      "aggregator": "avg"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "p95"
                    }
                  ],
                  "conditional_formats": [
                    {
                      "comparator": ">",
                      "value": 1500,
                      "palette": "white_on_red"
                    },
                    {
                      "comparator": ">",
                      "value": 1000,
                      "palette": "white_on_yellow"
                    },
                    {
                      "comparator": "<=",
                      "value": 1000,
                      "palette": "white_on_green"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Requests by status class",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:opsdesk.api.requests{$env} by {status_class}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ],
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "p95 latency by route (ms)",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "avg:opsdesk.api.latency_ms.95percentile{$env} by {route}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "APM: Next.js request p95 (s)",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "p95:trace.next.request{service:opsdesk-web,$env}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "AI assist",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "AI requests by outcome",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:opsdesk.ai.requests{$env} by {outcome,task}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ],
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "AI latency p50 / p95 (ms)",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "p50",
                      "query": "avg:opsdesk.ai.latency_ms.median{$env}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "p95",
                      "query": "avg:opsdesk.ai.latency_ms.95percentile{$env}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "p50",
                      "alias": "p50"
                    },
                    {
                      "formula": "p95",
                      "alias": "p95"
                    }
                  ],
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "AI tokens by direction",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:opsdesk.ai.tokens{$env} by {direction,model}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ],
                  "display_type": "bars"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Billing & business",
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Stripe webhooks",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "ok",
                      "query": "sum:opsdesk.stripe.webhook.received{$env} by {outcome}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "failed",
                      "query": "sum:opsdesk.stripe.webhook.failed{$env}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "ok"
                    },
                    {
                      "formula": "failed",
                      "alias": "failed"
                    }
                  ],
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Tickets created by channel",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:opsdesk.tickets.created{$env} by {channel}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ],
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Logins by outcome",
              "type": "timeseries",
              "show_legend": true,
              "legend_layout": "auto",
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "q1",
                      "query": "sum:opsdesk.auth.login{$env} by {outcome}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "q1"
                    }
                  ],
                  "display_type": "bars"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Error logs (trace-correlated)",
        "type": "log_stream",
        "indexes": [],
        "query": "service:opsdesk-web status:error $env",
        "columns": [
          "host",
          "service",
          "message"
        ],
        "show_date_column": true,
        "show_message_column": true,
        "message_display": "expanded-md",
        "sort": {
          "column": "time",
          "order": "desc"
        }
      }
    }
  ],
  "notify_list": []
}
