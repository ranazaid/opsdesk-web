# OpsDesk environment variables.
# Copy to .env.local for local development. Never commit real secrets:
# .gitignore ignores every .env* file except this template.
# Every variable is optional for local development: the app falls back to an
# embedded database, a dev signing key, an offline AI provider and no billing.

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. When unset, an embedded PGlite database
# (Postgres compiled to WASM) is used and migrated automatically.
# DATABASE_URL=postgres://opsdesk:opsdesk@localhost:5432/opsdesk
# Directory for the embedded PGlite database (default: .pglite).
# PGLITE_DATA_DIR=.pglite

# ── Auth ─────────────────────────────────────────────────────────────────────
# HMAC key for session cookies and API bearer tokens (HS256). Required in
# production, at least 32 characters. Generate one with: openssl rand -base64 48
AUTH_SECRET=
# Public base URL, used for Stripe Checkout / Portal redirect URLs.
APP_URL=http://localhost:3000
# Show the seeded demo accounts on the login page (set to "false" to hide).
NEXT_PUBLIC_DEMO_MODE=true

# ── AI assist (Anthropic) ────────────────────────────────────────────────────
# When unset, a deterministic offline mock provider is used.
ANTHROPIC_API_KEY=
# Model id used for summaries and reply drafts.
AI_MODEL=claude-sonnet-5-5

# ── Billing (Stripe, use test-mode keys) ─────────────────────────────────────
# Secret API key (sk_test_...). When unset, checkout and the portal are disabled.
STRIPE_SECRET_KEY=
# Signing secret for /api/stripe/webhook (whsec_...). With the Stripe CLI:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Recurring Price ids for the paid plans (price_...). Prices with the lookup
# keys opsdesk_pro / opsdesk_business are recognised too.
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ── Observability (Datadog) ──────────────────────────────────────────────────
# APM starts only when DD_ENV, DD_API_KEY or DD_AGENT_HOST is set.
# Deployment environment tag (e.g. production, staging).
DD_ENV=
# Service and version tags for traces, logs and metrics.
DD_SERVICE=opsdesk-web
DD_VERSION=
# Datadog Agent host for traces and DogStatsD metrics (default: localhost).
DD_AGENT_HOST=
# API key, only needed when the agent runs alongside the app (e.g. serverless).
DD_API_KEY=
# Set to "false" to force-disable tracing.
DD_TRACE_ENABLED=true
# Enable the continuous profiler.
DD_PROFILING_ENABLED=false
# pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
